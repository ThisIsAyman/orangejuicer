# OrangeTheory Fitness credentials
OTF_EMAIL=your_email@example.com
OTF_PASSWORD=your_password

# Reddit API credentials (create an app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=orangejuicer/0.1.0 by u/your_reddit_username

# Optional: output directory for charts (defaults to ./output)
OUTPUT_DIR=output
